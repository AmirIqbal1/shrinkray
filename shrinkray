#!/usr/bin/env bash
#
# shrinkray - point it at a video, get a much smaller one back.
# https://github.com/AmirIqbal1/shrinkray
#
set -euo pipefail

VERSION="1.2.0"

TARGET_MB=500
QUALITY="good"
CODEC="auto"
ENCODER="auto"
CONTAINER="mkv"
KEEP_ALL_AUDIO=false
OUTPUT=""
CUSTOM_OUTPUT=false
DRY_RUN=false
FORCE=false
REPLACE_ORIGINAL=false
TRANSACTION_ID=""
MACHINE_PROGRESS=false
BATCH_DIR=""
RECURSIVE=false

VIDEO_EXTS="mkv mp4 m4v avi mov wmv flv webm ts"
AUDIO_KBPS=128
ACTIVE_TEMP=""
ACTIVE_WORKDIR=""
ACTIVE_ENCODER_PID=""
ACTIVE_MONITOR_PID=""
ACTIVE_OUTPUT_DIR=""
ACTIVE_PROBE_DIR=""
ACTIVE_BACKUP=""
IN_REPLACEMENT_TRANSACTION=false
PENDING_SIGNAL=""
CRITICAL_DISK_TRIGGERED=false
ENCODER_WORKING_ALLOWANCE_BYTES=$((512 * 1024 * 1024))
MINIMUM_SAFETY_RESERVE_BYTES=$((2 * 1024 * 1024 * 1024))
CRITICAL_FREE_SPACE_BYTES=$((512 * 1024 * 1024))

say() { printf '==> %s\n' "$*"; }
warn() { printf '!!  %s\n' "$*" >&2; }
die() { printf 'xx  %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
shrinkray v${VERSION} - shrink a video file to a target size, safely.

USAGE:
  shrinkray
  shrinkray guided [--dry-run]
  shrinkray <file> [options]
  shrinkray --batch <directory> [--recursive] [options]
  shrinkray doctor

OPTIONS:
  --size <MB>         Target output size in MB             (default: 500)
  --quality <level>   fast | good | best                    (default: good)
  --codec <name>      auto | hevc | av1                     (default: auto)
                       auto uses HEVC; AV1 must be requested explicitly
  --encoder <name>    auto | software | qsv | vaapi | nvenc (default: auto)
  --container <fmt>   mkv | mp4                              (default: mkv)
  --keep-all-audio    Keep every audio track (default: first track only)
  --output <path>     Output path (default: <name>.shrunk.<container>)
  --replace-original  Replace the source only after successful validation
  --batch <dir>       Process video files in a directory
  --recursive         Include subdirectories in batch mode
  --dry-run           Show what would happen without encoding
  --machine-progress  Emit machine-readable FFmpeg progress (dashboard use)
  -y                  Replace an existing output without asking
  -h, --help          Show this help
  --version           Show version

EXAMPLES:
  shrinkray
  shrinkray guided --dry-run
  shrinkray movie.mkv
  shrinkray movie.mkv --size 700 --quality best
  shrinkray movie.mkv --size 1200 --replace-original
  shrinkray --batch ~/Movies --recursive --size 500
  shrinkray doctor
  shrinkray capabilities --json
EOF
}

cleanup_active() {
  if [ -n "$ACTIVE_MONITOR_PID" ] && kill -0 "$ACTIVE_MONITOR_PID" 2>/dev/null; then
    kill "$ACTIVE_MONITOR_PID" 2>/dev/null || true
    wait "$ACTIVE_MONITOR_PID" 2>/dev/null || true
  fi
  if [ -n "$ACTIVE_ENCODER_PID" ] && kill -0 "$ACTIVE_ENCODER_PID" 2>/dev/null; then
    kill -TERM "$ACTIVE_ENCODER_PID" 2>/dev/null || true
    wait "$ACTIVE_ENCODER_PID" 2>/dev/null || true
  fi
  if [ -n "$ACTIVE_TEMP" ] && [ -e "$ACTIVE_TEMP" ]; then
    rm -f -- "$ACTIVE_TEMP"
  fi
  if [ -n "$ACTIVE_WORKDIR" ] && [ -d "$ACTIVE_WORKDIR" ]; then
    rm -rf -- "$ACTIVE_WORKDIR"
  fi
  if [ -n "$ACTIVE_PROBE_DIR" ] && [ -d "$ACTIVE_PROBE_DIR" ]; then
    rm -rf -- "$ACTIVE_PROBE_DIR"
  fi
  ACTIVE_TEMP=""
  ACTIVE_WORKDIR=""
  ACTIVE_ENCODER_PID=""
  ACTIVE_MONITOR_PID=""
  ACTIVE_OUTPUT_DIR=""
  ACTIVE_PROBE_DIR=""
}

handle_signal() {
  local exit_code="$1"
  if [ "$IN_REPLACEMENT_TRANSACTION" = true ]; then
    PENDING_SIGNAL="$exit_code"
    return
  fi
  if [ -n "$ACTIVE_TEMP" ]; then
    warn "Encoding interrupted; removing the temporary output."
  else
    warn "Cancelled."
  fi
  cleanup_active
  trap - EXIT
  exit "$exit_code"
}

trap cleanup_active EXIT
trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

need_bin() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed. Run install.sh first."
}

human_size_mb() {
  local bytes="$1"
  printf '%s\n' "$(( (bytes + 1048575) / 1048576 ))"
}

file_size_bytes() {
  stat -c '%s' -- "$1"
}

human_bytes() {
  awk -v bytes="$1" 'BEGIN {
    split("B KB MB GB TB PB EB", units, " ")
    value = bytes + 0
    unit = 1
    while (value >= 1024 && unit < 7) { value /= 1024; unit++ }
    if (value >= 100 || unit <= 2) printf "%.0f %s\n", value, units[unit]
    else printf "%.1f %s\n", value, units[unit]
  }'
}

collect_disk_space() {
  local directory="$1"
  local target_bytes="$2"
  local available_blocks block_size total_blocks values
  read -r available_blocks block_size total_blocks < <(stat -f -c '%a %S %b' -- "$directory" 2>/dev/null) || return 1
  [[ "$available_blocks" =~ ^[0-9]+$ && "$block_size" =~ ^[0-9]+$ && "$total_blocks" =~ ^[0-9]+$ ]] || return 1
  values="$(awk \
    -v available_blocks="$available_blocks" \
    -v block_size="$block_size" \
    -v total_blocks="$total_blocks" \
    -v target="$target_bytes" \
    -v allowance="$ENCODER_WORKING_ALLOWANCE_BYTES" \
    -v minimum_reserve="$MINIMUM_SAFETY_RESERVE_BYTES" 'BEGIN {
      max = 9000000000000000000
      available = available_blocks * block_size
      capacity = total_blocks * block_size
      if (available > max) available = max
      if (capacity > max) capacity = max
      reserve = int(capacity / 10)
      if (reserve < minimum_reserve) reserve = minimum_reserve
      required = target + allowance + reserve
      if (required > max) required = max
      printf "%.0f %.0f %.0f\n", available, reserve, required
    }')" || return 1
  read -r DISK_AVAILABLE_BYTES DISK_RESERVE_BYTES DISK_REQUIRED_BYTES <<< "$values"
  [[ "$DISK_AVAILABLE_BYTES" =~ ^[0-9]+$ && "$DISK_REQUIRED_BYTES" =~ ^[0-9]+$ ]] || return 1
}

check_disk_space_preflight() {
  local directory="$1"
  local target_bytes="$2"
  if ! collect_disk_space "$directory" "$target_bytes"; then
    warn "Could not inspect free space on the destination filesystem."
    return 1
  fi
  say "Disk space check"
  printf '    Available: %s\n' "$(human_bytes "$DISK_AVAILABLE_BYTES")"
  printf '    Required: %s\n' "$(human_bytes "$DISK_REQUIRED_BYTES")"
  printf '    Safety reserve: %s\n' "$(human_bytes "$DISK_RESERVE_BYTES")"
  if [ "$DISK_AVAILABLE_BYTES" -lt "$DISK_REQUIRED_BYTES" ]; then
    warn "Not enough free disk space."
    warn "Available: $(human_bytes "$DISK_AVAILABLE_BYTES")"
    warn "Required: $(human_bytes "$DISK_REQUIRED_BYTES")"
    warn "Shrinkray will not start this encode."
    return 1
  fi
  say "Disk space: OK"
}

run_ffmpeg_with_disk_guard() {
  local encoder_status critical_flag
  critical_flag="${ACTIVE_WORKDIR}/critical-low-disk-space"
  rm -f -- "$critical_flag"
  "$@" &
  ACTIVE_ENCODER_PID="$!"
  (
    local warned=false
    while kill -0 "$ACTIVE_ENCODER_PID" 2>/dev/null; do
      if collect_disk_space "$ACTIVE_OUTPUT_DIR" 0; then
        if [ "$DISK_AVAILABLE_BYTES" -lt "$CRITICAL_FREE_SPACE_BYTES" ]; then
          : > "$critical_flag"
          warn "Critical low disk space"
          kill -TERM "$ACTIVE_ENCODER_PID" 2>/dev/null || true
          exit 0
        fi
      elif [ "$warned" = false ]; then
        warn "Could not refresh destination disk space while encoding."
        warned=true
      fi
      sleep 1
    done
  ) &
  ACTIVE_MONITOR_PID="$!"

  if wait "$ACTIVE_ENCODER_PID"; then
    encoder_status=0
  else
    encoder_status="$?"
  fi
  ACTIVE_ENCODER_PID=""
  if kill -0 "$ACTIVE_MONITOR_PID" 2>/dev/null; then
    kill "$ACTIVE_MONITOR_PID" 2>/dev/null || true
  fi
  wait "$ACTIVE_MONITOR_PID" 2>/dev/null || true
  ACTIVE_MONITOR_PID=""

  if [ -e "$critical_flag" ]; then
    CRITICAL_DISK_TRIGGERED=true
    return 1
  fi
  return "$encoder_status"
}

is_video_file() {
  local ext e
  ext="${1##*.}"
  ext="${ext,,}"
  for e in $VIDEO_EXTS; do
    [ "$ext" = "$e" ] && return 0
  done
  return 1
}

canonical_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$1"
    return
  fi

  local dir base
  dir="$(dirname -- "$1")"
  base="$(basename -- "$1")"
  dir="$(cd -- "$dir" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$base"
}

has_encoder() {
  local encoder_list="$1"
  local encoder="$2"
  [[ "$encoder_list" == *"$encoder"* ]]
}

has_hwaccel() {
  local hwaccel_list="$1"
  local hwaccel="$2"
  printf '%s\n' "$hwaccel_list" | grep -Fxq "$hwaccel"
}

json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

probe_hardware_encoder() {
  local backend="$1"
  local device="${2-}"
  local output status probe_ok=false
  local -a command
  ACTIVE_PROBE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/shrinkray-hwprobe.XXXXXX")" || return 1
  output="${ACTIVE_PROBE_DIR}/probe.mkv"
  command=(ffmpeg -y -hide_banner -loglevel error)
  case "$backend" in
    qsv)
      command+=(-init_hw_device "qsv=shrinkray_hw:${device}" -filter_hw_device shrinkray_hw
        -f lavfi -i "color=size=128x72:rate=5:duration=0.4"
        -vf "format=nv12,hwupload" -frames:v 2 -an -c:v hevc_qsv -b:v 500k -f matroska "$output")
      ;;
    vaapi)
      command+=(-vaapi_device "$device" -f lavfi -i "color=size=128x72:rate=5:duration=0.4"
        -vf "format=nv12,hwupload" -frames:v 2 -an -c:v hevc_vaapi -b:v 500k -f matroska "$output")
      ;;
    nvenc)
      command+=(-f lavfi -i "color=size=128x72:rate=5:duration=0.4"
        -frames:v 2 -an -c:v hevc_nvenc -b:v 500k -f matroska "$output")
      ;;
    *) rm -rf -- "$ACTIVE_PROBE_DIR"; ACTIVE_PROBE_DIR=""; return 1 ;;
  esac
  if command -v timeout >/dev/null 2>&1; then
    if timeout --signal=TERM --kill-after=2s 8s "${command[@]}" >/dev/null 2>&1; then status=0; else status=$?; fi
  else
    if "${command[@]}" >/dev/null 2>&1; then status=0; else status=$?; fi
  fi
  [ "$status" -eq 0 ] && [ -s "$output" ] && probe_ok=true
  rm -rf -- "$ACTIVE_PROBE_DIR"
  ACTIVE_PROBE_DIR=""
  [ "$probe_ok" = true ]
}

detect_hardware_capabilities() {
  local device dri_dir
  local -a render_devices=()
  ENCODER_LIST="$(ffmpeg -hide_banner -encoders 2>/dev/null || true)"
  HWACCEL_LIST="$(ffmpeg -hide_banner -hwaccels 2>/dev/null | sed '1d' | sed '/^[[:space:]]*$/d' || true)"
  CAP_SOFTWARE=false
  CAP_QSV=false
  CAP_VAAPI=false
  CAP_NVENC=false
  QSV_DEVICE=""
  VAAPI_DEVICE=""
  AUTO_ENCODER=""
  has_encoder "$ENCODER_LIST" libx265 && CAP_SOFTWARE=true
  dri_dir="${SHRINKRAY_DRI_DIR:-/dev/dri}"
  shopt -s nullglob
  for device in "$dri_dir"/renderD*; do
    [ -c "$device" ] || [ "${SHRINKRAY_ALLOW_REGULAR_RENDER_DEVICES:-0}" = 1 ] || continue
    if [ ! -r "$device" ] || [ ! -w "$device" ]; then
      continue
    fi
    render_devices+=("$device")
  done
  shopt -u nullglob
  if has_encoder "$ENCODER_LIST" hevc_qsv && has_hwaccel "$HWACCEL_LIST" qsv; then
    for device in "${render_devices[@]}"; do
      if probe_hardware_encoder qsv "$device"; then
        CAP_QSV=true
        QSV_DEVICE="$device"
        break
      fi
    done
  fi
  if has_encoder "$ENCODER_LIST" hevc_vaapi && has_hwaccel "$HWACCEL_LIST" vaapi; then
    for device in "${render_devices[@]}"; do
      if probe_hardware_encoder vaapi "$device"; then
        CAP_VAAPI=true
        VAAPI_DEVICE="$device"
        break
      fi
    done
  fi
  if has_encoder "$ENCODER_LIST" hevc_nvenc && has_hwaccel "$HWACCEL_LIST" cuda && probe_hardware_encoder nvenc; then
    CAP_NVENC=true
  fi
  if [ "$CAP_QSV" = true ]; then AUTO_ENCODER=qsv
  elif [ "$CAP_VAAPI" = true ]; then AUTO_ENCODER=vaapi
  elif [ "$CAP_NVENC" = true ]; then AUTO_ENCODER=nvenc
  elif [ "$CAP_SOFTWARE" = true ]; then AUTO_ENCODER=software
  fi
}

print_capabilities_json() {
  printf '{"encoders":{"software":%s,"qsv":%s,"vaapi":%s,"nvenc":%s},' \
    "$CAP_SOFTWARE" "$CAP_QSV" "$CAP_VAAPI" "$CAP_NVENC"
  printf '"auto_selected":%s,' "$(json_string "$AUTO_ENCODER")"
  printf '"devices":{"qsv":%s,"vaapi":%s}}\n' "$(json_string "$QSV_DEVICE")" "$(json_string "$VAAPI_DEVICE")"
}

doctor() {
  local self_path ffmpeg_line ffprobe_line encoder_list
  if command -v realpath >/dev/null 2>&1; then
    self_path="$(realpath -m -- "${BASH_SOURCE[0]}")"
  else
    self_path="${BASH_SOURCE[0]}"
  fi

  printf 'shrinkray doctor\n'
  printf '  Version:      %s\n' "$VERSION"
  printf '  Installation: %s\n' "$self_path"

  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg_line="$(ffmpeg -version 2>/dev/null | sed -n '1p')"
    printf '  ffmpeg:       %s (%s)\n' "${ffmpeg_line:-available}" "$(command -v ffmpeg)"
    encoder_list="$(ffmpeg -hide_banner -encoders 2>/dev/null || true)"
    if has_encoder "$encoder_list" libx265; then
      printf '  HEVC/libx265: available\n'
    else
      printf '  HEVC/libx265: unavailable\n'
    fi
    if has_encoder "$encoder_list" libsvtav1; then
      printf '  AV1/libsvtav1: available\n'
    else
      printf '  AV1/libsvtav1: unavailable\n'
    fi
  else
    printf '  ffmpeg:       not found\n'
    printf '  HEVC/libx265: unavailable\n'
    printf '  AV1/libsvtav1: unavailable\n'
  fi

  printf '\nHardware acceleration\n'
  if command -v ffmpeg >/dev/null 2>&1; then
    detect_hardware_capabilities
  else
    CAP_SOFTWARE=false CAP_QSV=false CAP_VAAPI=false CAP_NVENC=false
    QSV_DEVICE="" VAAPI_DEVICE="" AUTO_ENCODER=""
  fi
  printf '  Intel QSV:\n'
  printf '    device: %s\n' "${QSV_DEVICE:-not detected}"
  printf '    HEVC encode: %s\n' "$([ "$CAP_QSV" = true ] && printf available || printf unavailable)"
  printf '  VAAPI:\n'
  printf '    device: %s\n' "${VAAPI_DEVICE:-not detected}"
  printf '    HEVC encode: %s\n' "$([ "$CAP_VAAPI" = true ] && printf available || printf unavailable)"
  printf '  NVIDIA NVENC:\n'
  printf '    HEVC encode: %s\n' "$([ "$CAP_NVENC" = true ] && printf available || printf unavailable)"
  printf '  Selected auto backend:\n'
  printf '    %s\n' "${AUTO_ENCODER:-unavailable}"

  if command -v ffprobe >/dev/null 2>&1; then
    ffprobe_line="$(ffprobe -version 2>/dev/null | sed -n '1p')"
    printf '  ffprobe:      %s (%s)\n' "${ffprobe_line:-available}" "$(command -v ffprobe)"
  else
    printf '  ffprobe:      not found\n'
  fi
}

require_option_value() {
  local option="$1"
  local remaining="$2"
  local value="${3-}"
  if [ "$remaining" -lt 2 ]; then
    die "$option requires a value. See --help for an example."
  fi
  case "$value" in
    --*|-y|-h) die "$option requires a value. See --help for an example." ;;
  esac
}

default_output_for() {
  local input="$1"
  local dir base
  dir="$(dirname -- "$input")"
  base="$(basename -- "${input%.*}")"
  printf '%s/%s.shrunk.%s\n' "$dir" "$base" "$CONTAINER"
}

replacement_output_for() {
  local input="$1"
  local dir base
  dir="$(dirname -- "$input")"
  base="$(basename -- "${input%.*}")"
  printf '%s/%s.%s\n' "$dir" "$base" "$CONTAINER"
}

guided_prompt() {
  local prompt="$1"
  REPLY=""
  if [ -t 0 ]; then
    IFS= read -r -e -p "$prompt" REPLY
  else
    printf '%s' "$prompt"
    IFS= read -r REPLY
  fi
}

strip_surrounding_quotes() {
  local value="$1"
  local first last
  if [ "${#value}" -ge 2 ]; then
    first="${value:0:1}"
    last="${value: -1}"
    if { [ "$first" = '"' ] && [ "$last" = '"' ]; } || \
       { [ "$first" = "'" ] && [ "$last" = "'" ]; }; then
      value="${value:1:${#value}-2}"
    fi
  fi
  printf '%s\n' "$value"
}

format_duration() {
  local duration="$1"
  local total_seconds hours minutes seconds
  total_seconds="${duration%%.*}"
  [[ "$total_seconds" =~ ^[0-9]+$ ]] || total_seconds=0
  hours=$((total_seconds / 3600))
  minutes=$(((total_seconds % 3600) / 60))
  seconds=$((total_seconds % 60))
  printf '%02d:%02d:%02d\n' "$hours" "$minutes" "$seconds"
}

collect_ffprobe_info() {
  local input="$1"
  local probe_output key value
  PROBE_DURATION=""
  PROBE_WIDTH=""
  PROBE_HEIGHT=""
  PROBE_CODEC=""

  probe_output="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=codec_name,width,height:format=duration \
    -of default=noprint_wrappers=1 "$input" 2>/dev/null)" || return 1

  while IFS='=' read -r key value; do
    case "$key" in
      codec_name) PROBE_CODEC="$value" ;;
      width) PROBE_WIDTH="$value" ;;
      height) PROBE_HEIGHT="$value" ;;
      duration) PROBE_DURATION="$value" ;;
    esac
  done <<< "$probe_output"

  [[ "$PROBE_DURATION" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  [[ "$PROBE_WIDTH" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$PROBE_HEIGHT" =~ ^[1-9][0-9]*$ ]] || return 1
  [ -n "$PROBE_CODEC" ] || return 1
}

calculate_preset_size() {
  local original_bytes="$1"
  local percent="$2"
  local target_bytes target_mb
  target_bytes=$(( (original_bytes * percent + 99) / 100 ))
  target_mb=$(( (target_bytes + 1048575) / 1048576 ))
  [ "$target_mb" -ge 1 ] || target_mb=1
  printf '%s\n' "$target_mb"
}

guided_mode() {
  local input answer original_bytes original_mb formatted_duration
  local audio_description

  need_bin ffmpeg
  need_bin ffprobe

  printf '\nShrinkray guided mode\n'
  printf 'Choose a movie, choose how small you want it, and Shrinkray handles the rest.\n\n'

  while true; do
    if ! guided_prompt "Input movie path (or q to quit): "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    input="$(strip_surrounding_quotes "$REPLY")"
    case "${input,,}" in
      q|quit)
        say "Guided mode cancelled."
        return 2
        ;;
    esac
    if [ ! -f "$input" ]; then
      warn "Not a regular file: $input"
      continue
    fi
    if ! is_video_file "$input"; then
      warn "Unsupported video extension. Supported: $VIDEO_EXTS"
      continue
    fi
    break
  done

  if ! collect_ffprobe_info "$input"; then
    warn "ffprobe could not read a valid video stream from: $input"
    return 1
  fi

  original_bytes="$(file_size_bytes "$input")"
  original_mb="$(human_size_mb "$original_bytes")"
  formatted_duration="$(format_duration "$PROBE_DURATION")"

  printf '\nMovie details\n'
  printf '  Filename: %s\n' "$(basename -- "$input")"
  printf '  Original size: %s MB\n' "$original_mb"
  printf '  Duration: %s\n' "$formatted_duration"
  printf '  Resolution: %sx%s\n' "$PROBE_WIDTH" "$PROBE_HEIGHT"
  printf '  Video codec: %s\n' "$PROBE_CODEC"

  while true; do
    printf '\nHow small should it be?\n'
    printf '  1. Balanced — recommended (about 60%%, quality good)\n'
    printf '  2. Smaller file (about 40%%, quality good)\n'
    printf '  3. Better quality (about 75%%, quality best)\n'
    printf '  4. Exact size\n'
    if ! guided_prompt "Choice [1]: "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    answer="$REPLY"
    case "$answer" in
      ""|1)
        TARGET_MB="$(calculate_preset_size "$original_bytes" 60)"
        QUALITY="good"
        break
        ;;
      2)
        TARGET_MB="$(calculate_preset_size "$original_bytes" 40)"
        QUALITY="good"
        break
        ;;
      3)
        TARGET_MB="$(calculate_preset_size "$original_bytes" 75)"
        QUALITY="best"
        break
        ;;
      4)
        while true; do
          if ! guided_prompt "Exact target size in MB: "; then
            warn "No input received; guided mode cancelled."
            return 2
          fi
          if [[ "$REPLY" =~ ^[1-9][0-9]*$ ]]; then
            TARGET_MB="$REPLY"
            QUALITY="good"
            break 2
          fi
          warn "Enter a positive whole number of megabytes."
        done
        ;;
      *) warn "Choose 1, 2, 3, or 4." ;;
    esac
  done

  while true; do
    printf '\nOutput compatibility\n'
    printf '  1. MKV — recommended, keeps compatible subtitles\n'
    printf '  2. MP4 — maximum device compatibility, drops subtitles\n'
    if ! guided_prompt "Choice [1]: "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    case "$REPLY" in
      ""|1) CONTAINER="mkv"; break ;;
      2) CONTAINER="mp4"; break ;;
      *) warn "Choose 1 or 2." ;;
    esac
  done

  while true; do
    printf '\nAudio\n'
    printf '  1. Keep the first audio track — recommended\n'
    printf '  2. Keep every audio track\n'
    if ! guided_prompt "Choice [1]: "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    case "$REPLY" in
      ""|1)
        KEEP_ALL_AUDIO=false
        audio_description="First audio track"
        break
        ;;
      2)
        KEEP_ALL_AUDIO=true
        audio_description="Every audio track"
        break
        ;;
      *) warn "Choose 1 or 2." ;;
    esac
  done

  while true; do
    printf '\nOutput\n'
    printf '  1. Keep original — create a separate .shrunk file (recommended)\n'
    printf '  2. Replace original after successful validation\n'
    if ! guided_prompt "Choice [1]: "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    case "$REPLY" in
      ""|1) REPLACE_ORIGINAL=false; break ;;
      2)
        REPLACE_ORIGINAL=true
        printf '\nWARNING: The original movie will only be removed after the new encode has completed\n'
        printf 'and passed validation.\n'
        if ! guided_prompt "Type YES to confirm replacement: "; then
          warn "No input received; guided mode cancelled."
          return 2
        fi
        if [ "$REPLY" != "YES" ]; then
          warn "Replacement was not confirmed; guided mode cancelled."
          return 2
        fi
        break
        ;;
      *) warn "Choose 1 or 2." ;;
    esac
  done

  if [ "$REPLACE_ORIGINAL" = true ]; then
    OUTPUT="$(replacement_output_for "$input")"
  else
    OUTPUT="$(default_output_for "$input")"
  fi
  printf '\nReady to shrink\n'
  printf '  Input: %s\n' "$input"
  printf '  Original size: %s MB\n' "$original_mb"
  printf '  Target size: %s MB\n' "$TARGET_MB"
  printf '  Quality: %s\n' "$QUALITY"
  printf '  Container: %s\n' "${CONTAINER^^}"
  printf '  Audio handling: %s\n' "$audio_description"
  printf '  Replace original: %s\n' "$REPLACE_ORIGINAL"
  printf '  Output path: %s\n' "$OUTPUT"

  while true; do
    if ! guided_prompt "Start shrinking now? [Y/n] "; then
      warn "No input received; guided mode cancelled."
      return 2
    fi
    case "${REPLY,,}" in
      ""|y|yes) break ;;
      n|no)
        say "Guided mode cancelled; no files were created."
        return 2
        ;;
      *) warn "Answer y or n." ;;
    esac
  done

  GUIDED_INPUT="$input"
}

validate_output() {
  local output="$1"
  local stream_info
  say "Validating output..."
  [ -s "$output" ] || return 1
  stream_info="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type \
    -of csv=p=0 "$output" 2>/dev/null)" || return 1
  [ "$stream_info" = "video" ] || return 1
  ffprobe -v error -show_entries format=duration -of default=nw=1 "$output" \
    >/dev/null 2>&1
}

duration_within_tolerance() {
  local source_duration="$1"
  local output_duration="$2"
  awk -v source="$source_duration" -v output="$output_duration" 'BEGIN {
    if (source <= 0 || output <= 0) exit 1
    difference = source - output
    if (difference < 0) difference = -difference
    tolerance = source * 0.005
    if (tolerance < 2) tolerance = 2
    exit !(difference <= tolerance)
  }'
}

probe_duration() {
  ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null
}

validate_replacement_output() {
  local output="$1"
  local source_duration="$2"
  local source_size="$3"
  local output_duration output_size stream_info
  say "Validating replacement output..."
  [ -e "$output" ] || { warn "Encoded output does not exist; original was kept."; return 1; }
  if [ ! -f "$output" ] || [ -L "$output" ]; then
    warn "Encoded output is not a regular file; original was kept."
    return 1
  fi
  [ -s "$output" ] || { warn "Encoded output is empty; original was kept."; return 1; }
  stream_info="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 "$output" 2>/dev/null)" || {
    warn "ffprobe could not read the encoded output; original was kept."
    return 1
  }
  [ "$stream_info" = "video" ] || { warn "Encoded output has no video stream; original was kept."; return 1; }
  output_duration="$(probe_duration "$output")" || {
    warn "Encoded output duration is unreadable; original was kept."
    return 1
  }
  [[ "$output_duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    warn "Encoded output duration is unreadable; original was kept."
    return 1
  }
  if ! duration_within_tolerance "$source_duration" "$output_duration"; then
    warn "Encoded output duration does not match the source; original was kept."
    return 1
  fi
  output_size="$(file_size_bytes "$output")" || return 1
  if [ "$output_size" -ge "$source_size" ]; then
    warn "Encoded file is not smaller than the source; original was kept."
    return 1
  fi
}

replacement_artifact_paths() {
  local input="$1"
  local token="$2"
  local dir base
  dir="$(dirname -- "$input")"
  base="$(basename -- "$input")"
  ACTIVE_TEMP="${dir}/.${base}.shrinkray-replace-${token}.part.${CONTAINER}"
  ACTIVE_BACKUP="${dir}/.${base}.shrinkray-backup-${token}"
}

new_cli_transaction_id() {
  local random_id
  random_id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]')" || random_id=""
  if [[ "$random_id" =~ ^[0-9a-f]{32}$ ]]; then
    printf '%s\n' "$random_id"
  else
    printf '%s-%s-%s\n' "$$" "$RANDOM" "$RANDOM"
  fi
}

preserve_replacement_mode() {
  local input="$1"
  local output="$2"
  local mode
  mode="$(stat -c '%a' -- "$input")" || return 1
  chmod "$mode" -- "$output"
}

same_file_identity() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ -f "$2" ] && [ ! -L "$2" ] &&
    [ "$(stat -c '%d:%i' -- "$1")" = "$(stat -c '%d:%i' -- "$2")" ]
}

rollback_same_container() {
  local source="$1"
  local backup="$2"
  warn "Safe replacement did not complete; restoring the original."
  if same_file_identity "$source" "$backup"; then
    if rm -f -- "$backup"; then
      ACTIVE_BACKUP=""
      warn "The original movie remained in place."
      return 0
    fi
    warn "ROLLBACK FAILED. The recoverable original backup was left at: $backup"
    return 1
  fi
  if mv -f -- "$backup" "$source" && [ -f "$source" ] && [ ! -L "$source" ]; then
    ACTIVE_BACKUP=""
    warn "The original movie was restored."
    return 0
  fi
  warn "ROLLBACK FAILED. The recoverable original backup was left at: $backup"
  warn "Do not remove that backup until the original movie has been recovered."
  return 1
}

replace_same_container() {
  local source="$1"
  local temp="$2"
  local source_duration="$3"
  local source_size="$4"
  local source_identity="$5"
  local backup="$ACTIVE_BACKUP"

  if [ "$(stat -c '%d:%i:%s' -- "$source" 2>/dev/null || true)" != "$source_identity" ]; then
    warn "Source changed while encoding; original was kept."
    return 1
  fi
  if [ -e "$backup" ] || [ -L "$backup" ]; then
    warn "Shrinkray replacement backup already exists; original was kept: $backup"
    return 1
  fi
  IN_REPLACEMENT_TRANSACTION=true
  if ! ln -P -- "$source" "$backup"; then
    IN_REPLACEMENT_TRANSACTION=false
    warn "Could not create the required hard-link backup; original was kept."
    return 1
  fi
  if ! same_file_identity "$source" "$backup"; then
    warn "Could not verify the required hard-link backup; original was kept."
    if rm -f -- "$backup"; then
      ACTIVE_BACKUP=""
    else
      warn "The unverified backup was left for recovery attention at: $backup"
    fi
    IN_REPLACEMENT_TRANSACTION=false
    return 1
  fi

  if [ -n "$PENDING_SIGNAL" ]; then
    local pending_exit="$PENDING_SIGNAL"
    if rm -f -- "$backup"; then
      ACTIVE_BACKUP=""
    else
      warn "Cancellation kept the source and left its redundant backup at: $backup"
    fi
    PENDING_SIGNAL=""
    IN_REPLACEMENT_TRANSACTION=false
    handle_signal "$pending_exit"
  fi

  if ! mv -f -- "$temp" "$source"; then
    rollback_same_container "$source" "$backup" || true
    IN_REPLACEMENT_TRANSACTION=false
    return 1
  fi
  ACTIVE_TEMP=""
  if ! validate_replacement_output "$source" "$source_duration" "$source_size"; then
    rollback_same_container "$source" "$backup" || true
    IN_REPLACEMENT_TRANSACTION=false
    return 1
  fi
  if ! rm -f -- "$backup"; then
    IN_REPLACEMENT_TRANSACTION=false
    warn "Replacement succeeded, but the recoverable original backup could not be removed: $backup"
    return 1
  fi
  ACTIVE_BACKUP=""
  IN_REPLACEMENT_TRANSACTION=false
  if [ -n "$PENDING_SIGNAL" ]; then
    warn "Cancellation arrived after final replacement began; the safe replacement completed."
    PENDING_SIGNAL=""
  fi
  return 0
}

replace_different_container() {
  local source="$1"
  local temp="$2"
  local final="$3"
  local source_duration="$4"
  local source_size="$5"
  local source_identity="$6"

  if [ "$(stat -c '%d:%i:%s' -- "$source" 2>/dev/null || true)" != "$source_identity" ]; then
    warn "Source changed while encoding; original was kept."
    return 1
  fi
  if [ -e "$final" ] || [ -L "$final" ]; then
    warn "Replacement target already exists; original was kept: $final"
    return 1
  fi
  IN_REPLACEMENT_TRANSACTION=true
  if ! mv -n -- "$temp" "$final" || [ -e "$temp" ]; then
    IN_REPLACEMENT_TRANSACTION=false
    warn "Could not place the validated encode without overwriting a target; original was kept."
    return 1
  fi
  ACTIVE_TEMP=""
  if ! validate_replacement_output "$final" "$source_duration" "$source_size"; then
    if mv -- "$final" "$temp"; then
      ACTIVE_TEMP="$temp"
    else
      warn "The original remains safe; inspect the new artifact at: $final"
    fi
    IN_REPLACEMENT_TRANSACTION=false
    return 1
  fi
  if [ "$(stat -c '%d:%i:%s' -- "$source" 2>/dev/null || true)" != "$source_identity" ]; then
    IN_REPLACEMENT_TRANSACTION=false
    warn "Source changed during final placement; both files were kept."
    return 1
  fi
  if ! rm -f -- "$source"; then
    IN_REPLACEMENT_TRANSACTION=false
    warn "The new file is valid, but the original could not be removed; both files were kept."
    return 1
  fi
  IN_REPLACEMENT_TRANSACTION=false
  if [ -n "$PENDING_SIGNAL" ]; then
    warn "Cancellation arrived after final replacement began; the safe replacement completed."
    PENDING_SIGNAL=""
  fi
  return 0
}

run_software_hevc_encode() {
  local input="$1"
  local temp_output="$2"
  local video_kbps="$3"
  shift 3
  local -a mapping_args=("$@")

  say "Encoding with HEVC (pass 1 of 2)..."
  if ! run_ffmpeg_with_disk_guard ffmpeg -y -hide_banner -loglevel warning "${FFMPEG_PROGRESS_ARGS[@]}" \
      -i "$input" -map 0:v:0 \
      -c:v libx265 -preset "$X265_PRESET" -b:v "${video_kbps}k" \
      -x265-params "pass=1:stats=${ACTIVE_WORKDIR}/x265_2pass.log:log-level=error" \
      -an -sn -dn -f null /dev/null; then
    warn "HEVC pass 1 failed for $(basename -- "$input")."
    return 1
  fi

  say "Encoding with HEVC (pass 2 of 2)..."
  if ! run_ffmpeg_with_disk_guard ffmpeg -y -hide_banner -loglevel warning "${FFMPEG_PROGRESS_ARGS[@]}" \
      -i "$input" "${mapping_args[@]}" \
      -map_metadata 0 -map_chapters 0 \
      -c:v libx265 -preset "$X265_PRESET" -b:v "${video_kbps}k" \
      -x265-params "pass=2:stats=${ACTIVE_WORKDIR}/x265_2pass.log:log-level=error" \
      -c:a aac -b:a "${AUDIO_KBPS}k" \
      "${SUBTITLE_CODEC_ARGS[@]}" \
      -f "$OUTPUT_FORMAT" "$temp_output"; then
    warn "HEVC pass 2 failed for $(basename -- "$input")."
    return 1
  fi
}

encoder_display_name() {
  case "$1" in
    software) printf 'Software x265\n' ;;
    qsv) printf 'Intel QSV\n' ;;
    vaapi) printf 'VAAPI\n' ;;
    nvenc) printf 'NVIDIA NVENC\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

run_hardware_hevc_encode() {
  local backend="$1"
  local input="$2"
  local temp_output="$3"
  local video_kbps="$4"
  shift 4
  local -a mapping_args=("$@") device_args encoder_args filter_args
  local label
  label="$(encoder_display_name "$backend")"
  device_args=()
  encoder_args=()
  filter_args=()
  case "$backend" in
    qsv)
      device_args=(-init_hw_device "qsv=shrinkray_hw:${QSV_DEVICE}" -filter_hw_device shrinkray_hw)
      filter_args=(-vf "format=nv12,hwupload")
      encoder_args=(-c:v hevc_qsv -preset medium -b:v "${video_kbps}k")
      ;;
    vaapi)
      device_args=(-vaapi_device "$VAAPI_DEVICE")
      filter_args=(-vf "format=nv12,hwupload")
      encoder_args=(-c:v hevc_vaapi -rc_mode VBR -b:v "${video_kbps}k")
      ;;
    nvenc)
      encoder_args=(-c:v hevc_nvenc -preset p5 -rc vbr -b:v "${video_kbps}k")
      ;;
    *) return 1 ;;
  esac
  say "Encoding with HEVC hardware — ${label}..."
  say "Encoder backend: ${backend}"
  run_ffmpeg_with_disk_guard ffmpeg -y -hide_banner -loglevel warning "${FFMPEG_PROGRESS_ARGS[@]}" \
    "${device_args[@]}" -i "$input" "${mapping_args[@]}" \
    -map_metadata 0 -map_chapters 0 \
    "${filter_args[@]}" \
    "${encoder_args[@]}" \
    -c:a aac -b:a "${AUDIO_KBPS}k" \
    "${SUBTITLE_CODEC_ARGS[@]}" \
    -f "$OUTPUT_FORMAT" "$temp_output"
}

run_av1_encode() {
  local input="$1"
  local temp_output="$2"
  local video_kbps="$3"
  shift 3
  local -a mapping_args=("$@")

  say "Encoding with AV1... software AV1 encoding can be very slow."
  run_ffmpeg_with_disk_guard ffmpeg -y -hide_banner -loglevel warning "${FFMPEG_PROGRESS_ARGS[@]}" \
    -i "$input" "${mapping_args[@]}" \
    -map_metadata 0 -map_chapters 0 \
    -c:v libsvtav1 -preset "$SVT_PRESET" -b:v "${video_kbps}k" \
    -svtav1-params "rc=1" \
    -c:a "$AV1_AUDIO_CODEC" -b:a "${AUDIO_KBPS}k" \
    "${SUBTITLE_CODEC_ARGS[@]}" \
    -f "$OUTPUT_FORMAT" "$temp_output"
}

process_file() {
  local input="$1"
  local target_mb="$2"
  local output="$3"
  local codec="$4"
  local duration duration_int total_kbit total_kbps video_kbps
  local audio_map orig_bytes orig_mb target_bytes new_bytes new_mb saved_pct
  local answer same_container=false transaction_token source_identity
  local -a mapping_args

  [ -f "$input" ] || { warn "File not found: $input"; return 1; }
  if [ "$REPLACE_ORIGINAL" = true ] && [ -L "$input" ]; then
    warn "Replacement source must not be a symbolic link: $input"
    return 1
  fi
  [ -d "$(dirname -- "$output")" ] || { warn "Output directory does not exist: $(dirname -- "$output")"; return 1; }
  [ ! -d "$output" ] || { warn "Output path is a directory: $output"; return 1; }

  if [ "$(canonical_path "$input")" = "$(canonical_path "$output")" ] && [ "$REPLACE_ORIGINAL" = false ]; then
    warn "Input and output refer to the same file; refusing to replace the source."
    return 1
  fi
  if [ "$(canonical_path "$input")" = "$(canonical_path "$output")" ]; then
    same_container=true
  fi

  if [ "$REPLACE_ORIGINAL" = true ] && [ "$same_container" = false ]; then
    if [ -e "$output" ] || [ -L "$output" ]; then
      warn "Replacement target already exists; original was kept: $output"
      return 1
    fi
  fi

  duration="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$input" 2>/dev/null || true)"
  duration_int="${duration%%.*}"
  if ! [[ "$duration_int" =~ ^[0-9]+$ ]] || [ "$duration_int" -le 0 ]; then
    warn "Could not read a valid duration from: $input"
    return 1
  fi

  total_kbit=$(( target_mb * 8192 ))
  total_kbps=$(( total_kbit / duration_int ))
  video_kbps=$(( total_kbps - AUDIO_KBPS ))
  if [ "$video_kbps" -lt 64 ]; then
    warn "$(basename -- "$input"): ${target_mb} MB is too small for its duration; using the minimum video bitrate."
    video_kbps=64
  elif [ "$video_kbps" -lt 150 ]; then
    warn "$(basename -- "$input"): ${target_mb} MB is a very small target for its duration; quality may suffer."
  fi

  orig_bytes="$(file_size_bytes "$input")"
  source_identity="$(stat -c '%d:%i:%s' -- "$input")" || return 1
  orig_mb="$(human_size_mb "$orig_bytes")"
  target_bytes=$(( target_mb * 1024 * 1024 ))
  if [ "$target_bytes" -ge "$orig_bytes" ]; then
    warn "Requested target (${target_mb} MB) is not smaller than the original (${orig_mb} MB)."
  fi

  say ""
  say "File:    $(basename -- "$input")"
  say "Codec:   $codec"
  if [ "$codec" = hevc ]; then
    say "Encoder: $(encoder_display_name "$SELECTED_ENCODER")"
  fi
  say "Quality: $QUALITY"
  say "Target:  ${target_mb} MB (currently ${orig_mb} MB)"
  say "Output:  $output"
  if [ "$REPLACE_ORIGINAL" = true ]; then
    say "Mode:    replace original after successful validation"
  fi
  if [ "$CONTAINER" = "mp4" ]; then
    say "Note: MP4 output drops subtitles; use MKV to retain them."
  fi

  if [ "$DRY_RUN" = true ]; then
    say "Dry run complete; nothing was encoded."
    return 0
  fi

  if [ "$REPLACE_ORIGINAL" = false ] && [ -e "$output" ] && [ "$FORCE" = false ]; then
    if ! read -r -p "Output already exists. Replace it? [y/N] " answer; then
      warn "No response available; skipping $(basename -- "$input")."
      return 2
    fi
    case "$answer" in
      y|Y|yes|YES) ;;
      *) warn "Skipping $(basename -- "$input")."; return 2 ;;
    esac
  fi

  if ! check_disk_space_preflight "$(dirname -- "$output")" "$target_bytes"; then
    return 1
  fi

  cleanup_active
  CRITICAL_DISK_TRIGGERED=false
  if [ "$REPLACE_ORIGINAL" = true ]; then
    transaction_token="$TRANSACTION_ID"
    if [ -z "$transaction_token" ]; then
      transaction_token="$(new_cli_transaction_id)"
    fi
    replacement_artifact_paths "$input" "$transaction_token"
    if [ -e "$ACTIVE_TEMP" ] || [ -L "$ACTIVE_TEMP" ] || [ -e "$ACTIVE_BACKUP" ] || [ -L "$ACTIVE_BACKUP" ]; then
      warn "A Shrinkray replacement artifact already exists; original was kept."
      warn "Recovery attention required: ${ACTIVE_BACKUP}"
      ACTIVE_TEMP=""
      ACTIVE_BACKUP=""
      return 1
    fi
  else
    ACTIVE_TEMP="${output}.part"
  fi
  ACTIVE_WORKDIR="$(mktemp -d)"
  ACTIVE_OUTPUT_DIR="$(dirname -- "$output")"
  rm -f -- "$ACTIVE_TEMP"

  mapping_args=(-map 0:v:0)
  if [ "$KEEP_ALL_AUDIO" = true ]; then
    audio_map="0:a?"
  else
    audio_map="0:a:0?"
  fi
  mapping_args+=(-map "$audio_map")
  if [ "$CONTAINER" = "mkv" ]; then
    mapping_args+=(-map "0:s?")
  fi

  if [ "$codec" = "av1" ]; then
    if ! run_av1_encode "$input" "$ACTIVE_TEMP" "$video_kbps" "${mapping_args[@]}" || \
        ! validate_output "$ACTIVE_TEMP"; then
      rm -f -- "$ACTIVE_TEMP"
      if [ "$CRITICAL_DISK_TRIGGERED" = true ]; then
        warn "Encoding stopped because the destination filesystem has critically low free space."
        cleanup_active
        return 1
      fi
      if [ "$HAS_X265" = true ]; then
        warn "AV1 encoding or validation failed; retrying with available HEVC/libx265."
        codec="hevc"
      else
        warn "AV1 encoding or validation failed and HEVC/libx265 is not available; no fallback can be used."
        cleanup_active
        return 1
      fi
    fi
  fi

  if [ "$codec" = "hevc" ]; then
    if [ "$SELECTED_ENCODER" = software ]; then
      if ! run_software_hevc_encode "$input" "$ACTIVE_TEMP" "$video_kbps" "${mapping_args[@]}"; then
        cleanup_active
        return 1
      fi
    elif ! run_hardware_hevc_encode "$SELECTED_ENCODER" "$input" "$ACTIVE_TEMP" "$video_kbps" "${mapping_args[@]}"; then
      rm -f -- "$ACTIVE_TEMP"
      if [ "$CRITICAL_DISK_TRIGGERED" = true ]; then
        warn "Encoding stopped because the destination filesystem has critically low free space."
        cleanup_active
        return 1
      fi
      if [ "$ENCODER" = auto ] && [ "$CAP_SOFTWARE" = true ]; then
        warn "Hardware encoder unavailable; retrying with software HEVC."
        SELECTED_ENCODER=software
        if ! run_software_hevc_encode "$input" "$ACTIVE_TEMP" "$video_kbps" "${mapping_args[@]}"; then
          cleanup_active
          return 1
        fi
      else
        warn "Requested hardware encoder $(encoder_display_name "$SELECTED_ENCODER") failed; software fallback was not requested."
        cleanup_active
        return 1
      fi
    fi
  fi

  if [ "$REPLACE_ORIGINAL" = true ]; then
    if ! validate_replacement_output "$ACTIVE_TEMP" "$duration" "$orig_bytes"; then
      cleanup_active
      return 1
    fi
    if ! preserve_replacement_mode "$input" "$ACTIVE_TEMP"; then
      warn "Could not preserve source permissions; original was kept."
      cleanup_active
      return 1
    fi
    if [ "$same_container" = true ]; then
      if ! replace_same_container "$input" "$ACTIVE_TEMP" "$duration" "$orig_bytes" "$source_identity"; then
        cleanup_active
        return 1
      fi
    elif ! replace_different_container "$input" "$ACTIVE_TEMP" "$output" "$duration" "$orig_bytes" "$source_identity"; then
      cleanup_active
      return 1
    fi
  else
    if ! validate_output "$ACTIVE_TEMP"; then
      warn "ffprobe could not validate the completed encode; the final output was not changed."
      cleanup_active
      return 1
    fi

    if ! mv -f -- "$ACTIVE_TEMP" "$output"; then
      warn "Could not move the validated encode into place: $output"
      cleanup_active
      return 1
    fi
    ACTIVE_TEMP=""
  fi
  rm -rf -- "$ACTIVE_WORKDIR"
  ACTIVE_WORKDIR=""

  new_bytes="$(file_size_bytes "$output")"
  new_mb="$(human_size_mb "$new_bytes")"
  if [ "$new_bytes" -lt "$orig_bytes" ]; then
    saved_pct=$(( 100 - (new_bytes * 100 / orig_bytes) ))
    say "Done: ${orig_mb} MB -> ${new_mb} MB (${saved_pct}% smaller)"
  else
    say "Done: ${orig_mb} MB -> ${new_mb} MB (output is not smaller)"
  fi
}

if [ "${SHRINKRAY_SOURCE_ONLY:-0}" = 1 ]; then
  if [ "${BASH_SOURCE[0]}" != "$0" ]; then
    return 0
  fi
  exit 0
fi

if [ "${1-}" = "capabilities" ]; then
  if [ "$#" -ne 2 ] || [ "$2" != "--json" ]; then
    die "capabilities requires --json."
  fi
  if command -v ffmpeg >/dev/null 2>&1; then
    detect_hardware_capabilities
  else
    CAP_SOFTWARE=false CAP_QSV=false CAP_VAAPI=false CAP_NVENC=false
    QSV_DEVICE="" VAAPI_DEVICE="" AUTO_ENCODER=""
  fi
  print_capabilities_json
  exit 0
fi

if [ "${1-}" = "doctor" ]; then
  [ "$#" -eq 1 ] || die "doctor does not accept additional arguments."
  doctor
  exit 0
fi

GUIDED_MODE=false
GUIDED_INPUT=""
declare -a INPUTS=()
if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    GUIDED_MODE=true
  else
    warn "No arguments were provided and no interactive terminal is available."
    usage >&2
    exit 1
  fi
elif [ "$1" = "guided" ]; then
  GUIDED_MODE=true
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=true; shift ;;
      --encoder) require_option_value "$1" "$#" "${2-}"; ENCODER="$2"; shift 2 ;;
      --machine-progress) MACHINE_PROGRESS=true; shift ;;
      *) die "guided mode only supports --dry-run and --machine-progress; unsupported argument: $1" ;;
    esac
  done
fi

if [ "$GUIDED_MODE" = true ]; then
  if guided_mode; then
    INPUTS=("$GUIDED_INPUT")
  else
    guided_result=$?
    [ "$guided_result" -eq 2 ] && exit 0
    exit 1
  fi
else
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --size)
        require_option_value "$1" "$#" "${2-}"
        TARGET_MB="$2"
        shift 2
        ;;
      --quality)
        require_option_value "$1" "$#" "${2-}"
        QUALITY="$2"
        shift 2
        ;;
      --codec)
        require_option_value "$1" "$#" "${2-}"
        CODEC="$2"
        shift 2
        ;;
      --encoder)
        require_option_value "$1" "$#" "${2-}"
        ENCODER="$2"
        shift 2
        ;;
      --container)
        require_option_value "$1" "$#" "${2-}"
        CONTAINER="$2"
        shift 2
        ;;
      --output)
        require_option_value "$1" "$#" "${2-}"
        OUTPUT="$2"
        CUSTOM_OUTPUT=true
        shift 2
        ;;
      --replace-original) REPLACE_ORIGINAL=true; shift ;;
      --transaction-id)
        require_option_value "$1" "$#" "${2-}"
        TRANSACTION_ID="$2"
        shift 2
        ;;
      --batch)
        require_option_value "$1" "$#" "${2-}"
        BATCH_DIR="$2"
        shift 2
        ;;
      --keep-all-audio) KEEP_ALL_AUDIO=true; shift ;;
      --recursive) RECURSIVE=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --machine-progress) MACHINE_PROGRESS=true; shift ;;
      -y) FORCE=true; shift ;;
      -h|--help) usage; exit 0 ;;
      --version) printf 'shrinkray v%s\n' "$VERSION"; exit 0 ;;
      -*) die "Unknown option: $1 (see --help)" ;;
      *) INPUTS+=("$1"); shift ;;
    esac
  done
fi

[[ "$TARGET_MB" =~ ^[1-9][0-9]*$ ]] || die "--size must be a positive whole number of megabytes."
case "$QUALITY" in fast|good|best) ;; *) die "--quality must be fast, good, or best." ;; esac
case "$CODEC" in auto|hevc|av1) ;; *) die "--codec must be auto, hevc, or av1." ;; esac
case "$ENCODER" in auto|software|qsv|vaapi|nvenc) ;; *) die "--encoder must be auto, software, qsv, vaapi, or nvenc." ;; esac
case "$CONTAINER" in mkv|mp4) ;; *) die "--container must be mkv or mp4." ;; esac
if [ "$REPLACE_ORIGINAL" = true ] && [ "$CUSTOM_OUTPUT" = true ]; then
  die "--output cannot be used with --replace-original."
fi
if [ "$REPLACE_ORIGINAL" = false ] && [ -n "$TRANSACTION_ID" ]; then
  die "--transaction-id is only valid with --replace-original."
fi
if [ -n "$TRANSACTION_ID" ] && { [ "${#TRANSACTION_ID}" -gt 128 ] || ! [[ "$TRANSACTION_ID" =~ ^[A-Za-z0-9._-]+$ ]]; }; then
  die "--transaction-id contains unsafe characters."
fi

declare -a FFMPEG_PROGRESS_ARGS=(-stats)
if [ "$MACHINE_PROGRESS" = true ]; then
  FFMPEG_PROGRESS_ARGS=(-progress pipe:1 -nostats)
fi

if [ -n "$BATCH_DIR" ]; then
  [ "${#INPUTS[@]}" -eq 0 ] || die "Do not provide input files with --batch."
  [ -z "$OUTPUT" ] || die "--output cannot be used with --batch."
else
  [ "${#INPUTS[@]}" -gt 0 ] || die "No input file provided. See --help."
  [ "${#INPUTS[@]}" -eq 1 ] || die "Multiple input files require --batch."
  [ "$RECURSIVE" = false ] || die "--recursive can only be used with --batch."
fi

need_bin ffmpeg
need_bin ffprobe

ENCODER_LIST="$(ffmpeg -hide_banner -encoders 2>/dev/null || true)"
HAS_X265=false
HAS_SVTAV1=false
has_encoder "$ENCODER_LIST" libx265 && HAS_X265=true
has_encoder "$ENCODER_LIST" libsvtav1 && HAS_SVTAV1=true

case "$CODEC" in
  auto)
    CODEC="hevc"
    ;;
  hevc) ;;
  av1)
    [ "$HAS_SVTAV1" = true ] || die "AV1/libsvtav1 is not available in this ffmpeg build."
    ;;
esac

SELECTED_ENCODER=software
if [ "$CODEC" = hevc ]; then
  detect_hardware_capabilities
  case "$ENCODER" in
    auto)
      [ -n "$AUTO_ENCODER" ] || die "No working HEVC encoder is available."
      SELECTED_ENCODER="$AUTO_ENCODER"
      ;;
    software)
      [ "$CAP_SOFTWARE" = true ] || die "Software HEVC/libx265 is unavailable."
      SELECTED_ENCODER=software
      ;;
    qsv)
      [ "$CAP_QSV" = true ] || die "Intel QSV HEVC was requested but could not initialize on any accessible DRM render device."
      SELECTED_ENCODER=qsv
      ;;
    vaapi)
      [ "$CAP_VAAPI" = true ] || die "VAAPI HEVC was requested but could not initialize on any accessible DRM render device."
      SELECTED_ENCODER=vaapi
      ;;
    nvenc)
      [ "$CAP_NVENC" = true ] || die "NVIDIA NVENC HEVC was requested but could not initialize with the installed runtime."
      SELECTED_ENCODER=nvenc
      ;;
  esac
elif [ "$ENCODER" != auto ] && [ "$ENCODER" != software ]; then
  die "--encoder ${ENCODER} applies to HEVC; software AV1 remains available through --codec av1."
fi

case "$QUALITY" in
  fast) X265_PRESET="fast"; SVT_PRESET=8 ;;
  good) X265_PRESET="slow"; SVT_PRESET=6 ;;
  best) X265_PRESET="veryslow"; SVT_PRESET=4 ;;
esac

if [ "$CONTAINER" = "mp4" ]; then
  OUTPUT_FORMAT="mp4"
  AV1_AUDIO_CODEC="aac"
  SUBTITLE_CODEC_ARGS=()
else
  OUTPUT_FORMAT="matroska"
  AV1_AUDIO_CODEC="libopus"
  SUBTITLE_CODEC_ARGS=(-c:s copy)
fi

if [ -n "$BATCH_DIR" ]; then
  [ -d "$BATCH_DIR" ] || die "Not a directory: $BATCH_DIR"

  say "Scanning $BATCH_DIR for video files..."
  declare -a FIND_ARGS=("$BATCH_DIR")
  if [ "$RECURSIVE" = false ]; then
    FIND_ARGS+=(-maxdepth 1)
  fi
  FIND_ARGS+=(-type f -print0)

  declare -a FOUND_FILES=()
  mapfile -d '' -t FOUND_FILES < <(find "${FIND_ARGS[@]}" | sort -z)
  declare -a FILES=()
  SUCCESSFUL=0
  FAILED=0
  SKIPPED=0
  TOTAL_ORIG=0
  TOTAL_NEW=0

  for file in "${FOUND_FILES[@]}"; do
    is_video_file "$file" || continue
    if [[ "$file" == *".shrunk."* ]]; then
      SKIPPED=$((SKIPPED + 1))
    else
      FILES+=("$file")
    fi
  done

  say "Found ${#FILES[@]} source video file(s)."
  for file in "${FILES[@]}"; do
    if [ "$REPLACE_ORIGINAL" = true ]; then
      output_path="$(replacement_output_for "$file")"
      TRANSACTION_ID="batch-$(new_cli_transaction_id)"
    else
      output_path="$(default_output_for "$file")"
    fi
    before_bytes="$(file_size_bytes "$file")"
    if process_file "$file" "$TARGET_MB" "$output_path" "$CODEC"; then
      SUCCESSFUL=$((SUCCESSFUL + 1))
      if [ "$DRY_RUN" = false ]; then
        TOTAL_ORIG=$((TOTAL_ORIG + before_bytes))
        TOTAL_NEW=$((TOTAL_NEW + $(file_size_bytes "$output_path")))
      fi
    else
      result=$?
      if [ "$result" -eq 2 ]; then
        SKIPPED=$((SKIPPED + 1))
      else
        FAILED=$((FAILED + 1))
      fi
    fi
  done

  say ""
  if [ "$REPLACE_ORIGINAL" = true ]; then
    say "Batch summary: ${SUCCESSFUL} safely replaced, ${FAILED} replacement failed, ${SKIPPED} skipped."
  else
    say "Batch summary: ${SUCCESSFUL} successful, ${FAILED} failed, ${SKIPPED} skipped."
  fi
  if [ "$DRY_RUN" = false ] && [ "$SUCCESSFUL" -gt 0 ]; then
    say "Total size: $(human_size_mb "$TOTAL_ORIG") MB -> $(human_size_mb "$TOTAL_NEW") MB"
  fi
  [ "$FAILED" -eq 0 ] || exit 1
else
  INPUT="${INPUTS[0]}"
  [ -f "$INPUT" ] || die "File not found: $INPUT"
  if [ "$REPLACE_ORIGINAL" = true ]; then
    OUTPUT="$(replacement_output_for "$INPUT")"
  else
    OUTPUT="${OUTPUT:-$(default_output_for "$INPUT")}"
  fi
  if process_file "$INPUT" "$TARGET_MB" "$OUTPUT" "$CODEC"; then
    exit 0
  else
    result=$?
    [ "$result" -eq 2 ] && exit 0
    exit 1
  fi
fi
